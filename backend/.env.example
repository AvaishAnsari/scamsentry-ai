# ScamSentry AI — Backend Environment Configuration
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env to Git (it is listed in .gitignore).

# ── Database ────────────────────────────────────────────────────────────────
# Leave unset to use the default absolute path: backend/scamsentry.db
# The application uses an absolute path derived from database.py's own location,
# so the same database is used regardless of which directory you launch uvicorn from.
#
# Override for PostgreSQL (production):
#   DATABASE_URL=postgresql://user:password@localhost:5432/scamsentry
#DATABASE_URL=sqlite:////absolute/path/to/scamsentry.db

# ── Security ────────────────────────────────────────────────────────────────
# Salt used for hashing reporter fingerprints (anti-abuse).
# Change this in production to a strong random value.
REPORTER_HASH_SALT=hackathon_scamsentry_salt_2026
