# ScamSentry AI — Environment Variables Reference

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# Local Development: Leave unset or empty to use local SQLite (backend/scamsentry.db)
# Vercel Production: Provide a hosted PostgreSQL connection string (Neon, Supabase, etc.)
# Note: SQLite on Vercel runs in ephemeral /tmp and does not persist across cold starts.
# Example: postgresql://username:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Frontend API Base URL
# ---------------------------------------------------------------------------
# Local Development: Defaults to http://localhost:8000 if unset
# Vercel Production: Defaults to "" (same-origin /api) if unset
VITE_API_BASE_URL=http://localhost:8000
